{
  "name": "dsh-opendesign-limit",
  "version": "1.0.0",
  "description": "OpenDesign (AMR) subscription quota for the DSH Web GUI: the Design Plan 5-hour and 7-day windows, wallet balance and days-to-exhaust, read over two credential channels.",
  "type": "module",
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "plugin",
    "client",
    "locale",
    "docs",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opendesign",
    "quota",
    "usage"
  ],
  "license": "MIT",
  "author": "mako-o-o",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako-o-o/dsh-opendesign-limit.git"
  },
  "homepage": "https://github.com/mako-o-o/dsh-opendesign-limit#readme",
  "bugs": {
    "url": "https://github.com/mako-o-o/dsh-opendesign-limit/issues"
  }
}
